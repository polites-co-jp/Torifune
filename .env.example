# Torifune 環境変数のひな形。
# 実際の値は .env に書く。**.env は絶対にコミットしない。**

# --- アプリケーション ---
APP_ENV=development
# 本番では必ず設定する。CSRF の同一オリジン判定と Cookie の Secure 付与に使う。
# 未設定のときは x-forwarded-host / host ヘッダで代替する。
APP_URL=http://localhost:3000

# --- データベース ---
# 標準構成では 1 インスタンス = 1 データベース。
DATABASE_URL=postgresql://torifune:torifune@localhost:21700/torifune

# --- Secret 暗号化 ---
# SNS の Access Token や Plugin の Secret 設定を暗号化する鍵（AES-256-GCM）。
# 32 バイトを Base64 で指定する。生成例:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 未設定・不正な場合、アプリケーションは起動に失敗する（平文保存へフォールバックしない）。
# **この鍵を失うと、暗号化して保存した値は復号できない。** バックアップと同じ扱いで管理する。
TORIFUNE_ENCRYPTION_KEY=
# 暗号文へ併記する鍵の識別子。鍵をローテーションするとき、新旧を見分けるために変える。
TORIFUNE_ENCRYPTION_KEY_ID=k1

# --- メール送信 ---
# 設定するとパスワードリセットのメールを送る。**未設定なら送らない**（起動はする）。
# 送らない構成では、管理者が締め出されたときに
#   torifune reset-password --login-id=<id> --generate
# で復旧する。
# 例: smtps://user:password@smtp.example.com:465
TORIFUNE_SMTP_URL=
# 差出人。未設定なら Torifune <no-reply@localhost> を使う。
TORIFUNE_MAIL_FROM=
# リセットURLの組み立てには上の APP_URL を使う。
# **リクエストの Host ヘッダからは組み立てない**（差し替えられると、
# 攻撃者のサーバーを指すリンクをメールで送れてしまう）。
# SMTP を設定して APP_URL を設定しない場合、送信時にエラーになる。

# --- Plugin Registry ---
# Registry は「HTTPS で取れる JSON」と定義している（docs/設計/020-plugin-registry/）。
# 中央のサービスは無く、静的ファイルを置けば自前の Registry になる。
# **未設定なら Registry 機能は画面に出ない**（ローカルの zip 導入は使える）。
TORIFUNE_PLUGIN_REGISTRY_URL=
# Registry から入れる Plugin の署名を検証する ed25519 公開鍵（base64 の SPKI、カンマ区切り）。
# **未設定なら Registry からは導入できない。**
# 「署名は見るが誰の署名でもよい」は、検証していないのと同じ。
TORIFUNE_PLUGIN_TRUSTED_KEYS=

# --- CORS ---
# 外部の Web アプリケーションから API を使う場合にだけ設定する。
# カンマ区切り。**` * ` は指定できない**（起動時にエラーになる）。
TORIFUNE_CORS_ORIGINS=

# --- 開発用 compose ---
# compose.yaml がホストへ公開する PostgreSQL のポート。
TORIFUNE_DB_PORT=21700
TORIFUNE_DB_TEST_PORT=21701
